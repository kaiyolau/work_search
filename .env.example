# Copy to config/dev.env for local development (config/ is gitignored):
#   cp .env.example config/dev.env
# In production (e.g. Render) set these as environment variables instead.

# MongoDB connection string, e.g. from MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/work_search?retryWrites=true&w=majority

# Any long random string used to sign login tokens, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Google Geocoding API key (used to turn addresses into coordinates)
GEOCODE_API_KEY=

# Optional: frontend origin allowed by CORS in local dev (default http://localhost:5500)
# CLIENT_ORIGIN=http://localhost:5500

# Production only
# NODE_ENV=production
